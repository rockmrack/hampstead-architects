---
// Footer component
---

<footer class="section-padding bg-warm-stone/30 mt-section border-t border-charcoal/5" role="contentinfo">
  <div class="grid-editorial">
    <!-- Brand Column -->
    <div class="col-span-12 md:col-span-4">
      <h3 class="font-serif text-2xl mb-6">Hampstead Architects</h3>
      <p class="text-sm leading-relaxed text-charcoal/70">
        Part of the Hampstead Renovations Group.<br>
        We design what we can build.
      </p>
    </div>

    <!-- Address Column -->
    <div class="col-span-12 md:col-span-4 mt-8 md:mt-0">
      <h4 class="font-sans text-xs uppercase tracking-wider mb-4 text-charcoal/50">Office & Showroom</h4>
      <address class="not-italic text-sm leading-relaxed">
        Unit 3, Palace Court<br>
        250 Finchley Road<br>
        Hampstead, London NW3 6DN
      </address>
      <p class="text-xs text-charcoal/60 mt-3">
        Mon-Fri: 9am - 8pm<br>
        Saturday: 9am - 6pm<br>
        Sunday: By appointment
      </p>
    </div>

    <!-- Contact Column -->
    <div class="col-span-12 md:col-span-4 mt-8 md:mt-0">
      <h4 class="font-sans text-xs uppercase tracking-wider mb-4 text-charcoal/50">Get in Touch</h4>
      <p class="text-sm leading-relaxed">
        <a href="tel:+442080548756" class="hover:text-bronze transition-colors">020 8054 8756</a><br>
        <a href="mailto:hello@hampsteadarchitects.co.uk" class="hover:text-bronze transition-colors">hello@hampsteadarchitects.co.uk</a>
      </p>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="mt-16 pt-8 border-t border-charcoal/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-charcoal/50">
    <p>&copy; {new Date().getFullYear()} Hampstead Architects. All rights reserved.</p>

    <div class="flex gap-6">
      <a href="/privacy" class="hover:text-bronze transition-colors">Privacy Policy</a>
      <a href="/terms" class="hover:text-bronze transition-colors">Terms of Service</a>
    </div>
  </div>

  <!-- Accreditations -->
  <div class="mt-8 pt-8 border-t border-charcoal/10">
    <p class="text-xs text-charcoal/40 text-center">
      Registered with RIBA · Approved by English Heritage · Camden Conservation Area Specialists<br>
      Company Reg: 16838595 · Professional Indemnity Insurance: £10M (Aviva)
    </p>
  </div>
</footer>
